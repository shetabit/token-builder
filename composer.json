{
    "name": "shetabit/token-builder",
    "type": "library",
    "description": "Laravel Token Builder",
    "keywords": [
        "laravel",
        "token",
        "token builder",
        "onetime token",
        "expiring tokens",
        "one usage token",
        "expire token generator",
        "pin generator",
        "one time usage pin",
        "pin number",
        "laravel pin number",
        "laravel token",
        "laravel token builder",
        "laravel pin builder",
        "laravel pin generator"
    ],
    "homepage": "https://github.com/shetabit/token-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahdi Khanzadi",
            "email": "khanzadimahdi@gmail.com",
            "homepage": "https://github.com/shetabit",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^10.0|^11.0",
        "phpcsstandards/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Shetabit\\TokenBuilder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shetabit\\TokenBuilder\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "check-style": "phpcs",
        "fix-style": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "ci": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shetabit\\TokenBuilder\\Provider\\TokenBuilderServiceProvider"
            ],
            "aliases": {
                "TokenBuilder": "Shetabit\\TokenBuilder\\Facade\\TokenBuilder"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test-coverage": "Run the test suite and report code coverage.",
        "check-style": "Check the coding style of database, src and tests.",
        "fix-style": "Fix the coding style of database, src and tests where possible.",
        "analyse": "Run static analysis on src and tests.",
        "rector": "Show the refactorings Rector would apply.",
        "ci": "Run every check the CI pipeline runs."
    }
}
